# Required for the live Supabase backend.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Development/internal-demo builds only. Never enable for external beta or production.
EXPO_PUBLIC_ENABLE_DEMO_MODE=false
EXPO_PUBLIC_SENTRY_DSN=
# RevenueCat public iOS SDK key (safe for the app bundle; never use a secret key here).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
