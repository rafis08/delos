{
  "expo": {
    "name": "Delos",
    "slug": "delos",
    "scheme": "delos",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/delos-app-icon.png",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Delos lets you choose musician profile photos that other signed-in members can see.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Delos uses an approximate location to calculate musician distance. Your precise location is never shown publicly."
        }
      ],
      "@sentry/react-native",
      "expo-font",
      "expo-audio",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.delos-music.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.delosmusic.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/delos-guardian.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "34db13e4-a4b9-4430-b9b9-f99a6674a099"
      }
    },
    "owner": "rafis08"
  }
}
